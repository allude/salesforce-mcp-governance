{
  "name": "salesforce-mcp-server",
  "version": "1.0.0",
  "description": "Zero-Trust Enterprise Salesforce MCP Server (Streamable HTTP) with Next.js App Router Admin & Governance Panel",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-stack.mjs dev",
    "dev:web": "next dev --port 3000",
    "dev:mcp": "PORT=3001 tsx watch src/index.ts",
    "build": "npm run build:mcp && next build",
    "build:mcp": "tsc -p tsconfig.server.json",
    "start": "node scripts/run-stack.mjs start",
    "start:web": "next start --port 3000",
    "start:mcp": "NODE_ENV=${NODE_ENV:-production} PORT=3001 node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:self",
    "test:unit": "NODE_ENV=test tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:self": "NODE_ENV=test tsx src/test-self.ts",
    "test:e2e": "bash scripts/smoke-e2e.sh",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@tailwindcss/postcss": "^4.2.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "lucide-react": "^1.16.0",
    "next": "^16.2.4",
    "postcss": "^8.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
