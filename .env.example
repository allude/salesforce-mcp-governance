# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Security & Encryption Keys (Auto-generated if omitted in dev, MUST be set in production)
# 32-byte hex key (64 hex characters) for AES-256-GCM encryption & JWT signing
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local Bootstrap Admin Break-Glass Password (Used before Okta SSO is configured, or in dev)
ADMIN_BOOTSTRAP_EMAIL=admin@company.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeInProd!2026

# Okta OIDC SSO Configuration (Can also be configured via Admin UI)
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_REDIRECT_URI=http://localhost:3000/auth/okta/callback
OKTA_REQUIRED_GROUP=

# Salesforce Org Configuration
# Restrict which Salesforce MyDomain URLs are trusted by the MCP Server (SSRF protection)
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_ALLOWED_DOMAINS=.my.salesforce.com,.salesforce.com
SALESFORCE_API_VERSION=v62.0

# Optional: Salesforce Connected App for Admin "Sync Profiles" OAuth flow
SALESFORCE_ADMIN_CLIENT_ID=
SALESFORCE_ADMIN_CLIENT_SECRET=
SALESFORCE_ADMIN_REDIRECT_URI=http://localhost:3000/api/admin/salesforce/callback
