# Copy to `.env`. Both services read it: the Express MCP backend (via dotenv) and the Next.js portal.

# Server Configuration
# Express MCP + Admin API backend port. The Next.js Admin Portal runs on :3000 and proxies to it.
PORT=3001
# Public origin clients and browsers use (the Next.js portal, which proxies /mcp, /api/admin, /auth/okta, /.well-known, /healthz, /docs)
BASE_URL=http://localhost:3000
# Where the Next.js portal proxies backend requests (read by `next dev`, and at `next build` time for `next start`)
MCP_BACKEND_URL=http://127.0.0.1:3001
# Address the backend listens on. Keep loopback so only the portal proxy can reach it; production refuses
# anything else unless ALLOW_PUBLIC_BACKEND=true (only behind a private network policy or mTLS).
# MCP_BACKEND_HOST=127.0.0.1
# ALLOW_PUBLIC_BACKEND=false
# Set NODE_ENV=production in the real process environment for production (enables the fail-fast secret checks).
# Express `trust proxy` setting (rate-limit keys and audit-log IPs). Leave it `false` unless a load balancer /
# TLS proxy in front of the portal appends the client address to X-Forwarded-For; then use `loopback`
# (the Next.js proxy itself forwards the header unchanged, so trusting it without such a proxy lets clients forge it).
TRUST_PROXY=false
# SQLite database file (defaults to ./data/mcp-governance.sqlite)
# DB_PATH=./data/mcp-governance.sqlite

# Security & Encryption Keys
# 32-byte hex key (64 hex characters) for AES-256-GCM encryption, JWT and simulator-token signing.
# REQUIRED in production (`npm start` runs the backend with NODE_ENV=production): the server refuses to start
# without it, or with a publicly known value.
# Generate one with: openssl rand -hex 32
# If unset in development/test, a deterministic insecure development key is used (with a warning).
# APP_SECRET_KEY=<output of openssl rand -hex 32>

# Local Bootstrap Admin (break-glass login used before Okta SSO is configured).
# Seeded only when the database has no portal users. Defaults: admin / admin123 (development only;
# production refuses to start while any portal account uses a publicly known password).
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
# Production asks every password sign-in for an authenticator (TOTP) code. This base32 secret (at least
# 16 characters, e.g. from `openssl rand 20 | base32`) is enrolled on the bootstrap account at startup when
# it has none yet; add the same secret to an authenticator app. Or enroll later with
# `npm run portal:totp -- <username>` on the server.
# ADMIN_BOOTSTRAP_TOTP_SECRET=
# In production, password sign-in is closed while Okta SSO is enabled. Set this to true only for the
# duration of a break-glass event (Okta down); every such sign-in is logged and printed as BREAK-GLASS.
# BREAK_GLASS_ENABLED=false

# Okta OIDC SSO: pre-fills the Okta settings on first start. Enable and edit them in the Admin Portal.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Leave empty to use <BASE_URL>/auth/okta/callback (follows BASE_URL if it changes)
OKTA_REDIRECT_URI=
OKTA_REQUIRED_GROUP=MCP-Admins

# Salesforce Org Configuration
# Seeds the login URL and MCP token host on first start only; an existing database ignores it. Edit both
# in the Admin Portal. A real connect moves the token host to the org's host while it is a generic login host.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# SSRF protection: hosts the server may call. Entries starting with "." match that domain and its subdomains.
SALESFORCE_ALLOWED_DOMAINS=.my.salesforce.com,.salesforce.com,.force.com
SALESFORCE_API_VERSION=v62.0
